---
import { getBasePath, profilePath, withBase } from "../lib/legacyHtml";

type Props = {
  title?: string;
  home?: boolean;
  type?: string;
};

const { title, home = false, type = "" } = Astro.props;
const htmlClass = [home ? "page-home" : "", type].filter(Boolean).join(" ");
const pageTitle = `${title ? `${title} | ` : ""}THE DaROZA DYNASTY`;
const basePath = getBasePath();

const navItems = [
  ["gail-haggard", "Gail Haggard"],
  ["lorraine-daroza", "Lorraine DaRoza"],
  ["gwen-wilder", "Gwen Wilder"],
  ["flora-daroza", "Flora DaRoza"],
  ["wes-costa", "Wes Costa"],
  ["julia-coster", "Julia Coster"],
  ["greg-costa", "Greg Costa"],
] as const;
---

<!doctype html>
<html class={htmlClass}>
  <head>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <meta content="minimum-scale=1.0, width=device-width, maximum-scale=0.6667, user-scalable=no" name="viewport" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link href="https://fonts.googleapis.com/css?family=Alegreya:400italic,900italic,400,900" rel="stylesheet" type="text/css" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <link rel="stylesheet" href={withBase("/assets/css/screen.css")} />
    <link rel="stylesheet" href={withBase("/assets/css/component.css")} />
    <script src={withBase("/assets/js/modernizr.custom.25376.js")}></script>
  </head>
  <body>
    <header id="header">
      <nav>
        <h1 id="showMenu"><span>THE DaROZA DYNASTY</span></h1>
      </nav>
    </header>

    <div id="perspective" class="perspective effect-movedown">
      <div class="container">
        <div class="wrapper">
          <slot />

          <footer>
            <p>It has taken years to collect, curate and record my family's history and I've barely scratched the surface. What you see in this document is an exploration of an atypical Californian family. A common theme throughout my lineage is strong women providing for themselves and their kin passed their due. It's clear to see the turning points in my Great Great Grandmother's life and how it has rippled down generations.</p>

            <p>Each person portrayed here is done so with love and kindness, and I hope that I have done their character justice.</p>
            <img src={withBase("/assets/img/logo.svg")} class="logo-footer" alt="" />
            <h3>A Study Of Family</h3>
            <p>by Jonathan Haggard</p>
            <p class="colophon">All icons from <a href="https://thenounproject.com/">The Noun Project</a>.</p>
          </footer>
        </div>
      </div>

      <nav class="outer-nav top horizontal">
        <a class="logohome" href={withBase("/")}><img src={withBase("/assets/img/logo-nav.svg")} alt="" /></a>
        <div class="positionernav">
          <section class="relatives">
            <div class="nav-relatives-grid">
              {
                navItems.map(([slug, name]) => (
                  <a href={profilePath(slug)}>
                    <div class="nav-avatar">
                      <div class="nav-fade" />
                      <img src={withBase(`/assets/img/card-thumbs/${slug}.jpg`)} alt="" />
                    </div>
                    <span class="nav-name">{name}</span>
                  </a>
                ))
              }
            </div>
          </section>
        </div>
      </nav>
    </div>

    <script define:vars={{ basePath }}>
      window.__DAROZA_BASE__ = basePath;
    </script>
    <script src={withBase("/assets/js/jquery-1.9.1.min.js")}></script>
    <script src={withBase("/assets/js/jquery.fittext.js")}></script>
    <script src={withBase("/assets/js/classie.js")}></script>
    <script src={withBase("/assets/js/menu.js")}></script>
    <script src={withBase("/assets/js/functions.js")}></script>
    <script>
      $(".fithome").fitText(1.4, { minFontSize: "30px", maxFontSize: "160px" });
      $(".fittext").fitText(1.8, { minFontSize: "30px", maxFontSize: "160px" });
    </script>
    <script>
      (function(i,s,o,g,r,a,m){i["GoogleAnalyticsObject"]=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
      })(window,document,"script","https://www.google-analytics.com/analytics.js","ga");

      ga("create", "UA-58689429-1", "auto");
      ga("send", "pageview");
    </script>
  </body>
</html>
