---
import { profilePages, type ProfilePage } from "../../data/legacyPages";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseLegacyPage, rewriteLegacyHtml } from "../../lib/legacyHtml";

export function getStaticPaths() {
  return profilePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: ProfilePage };
const { frontmatter, body } = parseLegacyPage(page.raw);
const html = rewriteLegacyHtml(body);
---

<BaseLayout title={frontmatter.title} home={frontmatter.home === true} type={frontmatter.type}>
  <Fragment set:html={html} />
</BaseLayout>
